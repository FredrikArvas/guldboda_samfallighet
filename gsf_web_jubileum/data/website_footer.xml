<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gsf_jubileum_footer_about" inherit_id="website.footer_custom" name="GSF Jubileum Footer — Om oss">
    <xpath expr="//div[hasclass('col-lg-5')][hasclass('pt24')]" position="replace">
      <div class="col-lg-5 pt24 pb24">
        <h5>Guldboda 80 år</h5>
        <p>Jubileumsprojekt i samarbete med GTFF — hjälp oss samla fastigheternas historia.</p>
      </div>
    </xpath>
  </template>

  <template id="gsf_jubileum_footer_contact" inherit_id="website.footer_custom" name="GSF Jubileum Footer — Kontakt">
    <xpath expr="//div[hasclass('col-lg-4')][hasclass('offset-lg-1')]" position="replace">
      <div class="col-lg-4 offset-lg-1 pt24 pb24">
        <h5>Kontakt</h5>
        <ul class="list-unstyled">
          <li>
            <i class="fa fa-envelope fa-fw me-2"/>
            <a href="mailto:fredrik@arvas.se">fredrik@arvas.se</a>
          </li>
          <li>
            <i class="fa fa-phone fa-fw me-2"/>
            <a href="tel:+46708145595">070-814 55 95</a>
          </li>
        </ul>
      </div>
    </xpath>
  </template>

  <template id="gsf_jubileum_footer_links" inherit_id="website.footer_custom" name="GSF Jubileum Footer — Länkar">
    <xpath expr="//div[hasclass('col-lg-2')][hasclass('pt24')]" position="replace">
      <div class="col-lg-2 pt24 pb24">
        <h5>Länkar</h5>
        <ul class="list-unstyled">
          <li><a href="/web/login">Logga in</a></li>
          <li><a href="https://guldboda.se" target="_blank">guldboda.se</a></li>
        </ul>
      </div>
    </xpath>
  </template>

  <template id="gsf_jubileum_footer_copyright" inherit_id="website.layout" name="GSF Jubileum Copyright" priority="20">
    <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
      <span class="o_footer_copyright_name me-2 small">
        Copyright &#169; Guldboda Samfällighetsförening
      </span>
    </xpath>
  </template>

  <template id="gsf_jubileum_brand_promotion" inherit_id="web.brand_promotion" name="GSF Jubileum Brand Promotion" priority="25">
    <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
      <div class="o_brand_promotion">
        <small class="text-muted">Powered by <a target="_blank" href="https://www.odoo.com/page/community">Odoo Community</a></small>
      </div>
    </xpath>
  </template>

</odoo>
